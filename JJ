function jjAtaquesAldeia() {
  'use strict';
  if (!window.game_data) { alert('Abra este script dentro do jogo.'); return; }
  const GD = window.game_data;
  if (GD.screen !== 'overview') {
    if (confirm('Este script roda na tela da aldeia. Abrir a visualização da aldeia agora?')) {
      location.href = `/game.php?village=${GD.village.id}&screen=overview`;
    }
    return;
  }

  const BOX_ID = 'jj-incs-aldeia';
  const LS_KEY = 'jj_incs_cfg_' + GD.world;
  const CACHE_KEY = 'jj_incs_apoio_v2_' + GD.world;
  const P_ATQ = '⚔', P_APOIO = '🛡';

  // a = ataque | t = tipo (0 inf, 1 cav, 2 arq) | d = [def inf, def cav, def arq]
  const UNITS = {
    spear:    { a: 10,  t: 0, d: [15, 45, 20],    ab: 'lanç',  nome: 'lanceiro' },
    sword:    { a: 25,  t: 0, d: [50, 15, 40],    ab: 'esp',   nome: 'espadachim' },
    axe:      { a: 40,  t: 0, d: [10, 5, 10],     ab: 'bárb',  nome: 'bárbaro' },
    archer:   { a: 15,  t: 2, d: [50, 40, 5],     ab: 'arq',   nome: 'arqueiro' },
    spy:      { a: 0,   t: 1, d: [0, 0, 0],       ab: 'expl',  nome: 'explorador' },
    light:    { a: 130, t: 1, d: [30, 40, 30],    ab: 'CL',    nome: 'cavalaria leve' },
    marcher:  { a: 120, t: 2, d: [40, 30, 50],    ab: 'AC',    nome: 'arqueiro a cavalo' },
    heavy:    { a: 150, t: 1, d: [200, 80, 180],  ab: 'CP',    nome: 'cavalaria pesada' },
    ram:      { a: 2,   t: 0, d: [20, 50, 20],    ab: 'ar',    nome: 'aríete' },
    catapult: { a: 100, t: 0, d: [100, 50, 100],  ab: 'cat',   nome: 'catapulta' },
    knight:   { a: 150, t: 1, d: [250, 400, 150], ab: 'pala',  nome: 'paladino' },
    snob:     { a: 30,  t: 0, d: [100, 50, 100],  ab: 'nobre', nome: 'nobre' },
    militia:  { a: 0,   t: 0, d: [15, 45, 25],    ab: 'mil',   nome: 'milícia' }
  };
  const SIEGE = ['ram', 'catapult'];

  const DEF_CFG = { full: { axe: 6500, light: 3000, marcher: 0, ram: 300 }, renomear: true };
  let cfg;
  try { cfg = Object.assign({}, DEF_CFG, JSON.parse(localStorage.getItem(LS_KEY) || '{}')); } catch (e) { cfg = { ...DEF_CFG }; }
  cfg.full = Object.assign({}, DEF_CFG.full, cfg.full);
  const salvarCfg = () => { try { localStorage.setItem(LS_KEY, JSON.stringify(cfg)); } catch (e) {} };

  let cacheApoio = {};
  try { cacheApoio = JSON.parse(sessionStorage.getItem(CACHE_KEY) || '{}'); } catch (e) {}
  const salvarCache = () => { try { sessionStorage.setItem(CACHE_KEY, JSON.stringify(cacheApoio)); } catch (e) {} };

  // ---------- utilidades ----------
  const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
  const num = (t) => parseInt(String(t || '').replace(/\D/g, ''), 10) || 0;
  const fmtN = (n) => n.toLocaleString('pt-BR');
  const pad = (n) => String(n).padStart(2, '0');
  const hms = (ms) => { const d = new Date(ms); return `${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`; };
  const unitDoSrc = (src) => ((src || '').match(/unit_([a-z]+)/) || [])[1];

  function serverWallNow() {
    const d = document.querySelector('#serverDate')?.textContent.trim();
    const t = document.querySelector('#serverTime')?.textContent.trim();
    if (d && t) {
      const [dd, mm, yy] = d.split('/').map(Number);
      const [h, m, s] = t.split(':').map(Number);
      return new Date(yy, mm - 1, dd, h, m, s).getTime();
    }
    return Date.now();
  }
  function parseHMS(text) {
    const m = String(text || '').match(/(\d+):(\d{2}):(\d{2})/);
    return m ? (+m[1]) * 3600 + (+m[2]) * 60 + (+m[3]) : null;
  }

  // ---------- leitura: unidades da aldeia ----------
  function lerUnidades() {
    const out = {};
    const box = document.querySelector('#show_units') ||
      [...document.querySelectorAll('.vis, table')].find((t) => /Unidades/.test(t.querySelector('th, h4')?.textContent || ''));
    if (!box) return out;
    box.querySelectorAll('tr').forEach((tr) => {
      const link = tr.querySelector('[data-unit]');
      let u = link?.getAttribute('data-unit');
      if (!u) u = unitDoSrc(tr.querySelector('img')?.getAttribute('src'));
      if (!u || !UNITS[u]) return;
      const forte = tr.querySelector('strong');
      out[u] = (out[u] || 0) + num(forte ? forte.textContent : tr.textContent);
    });
    return out;
  }

  // ---------- leitura: efeitos ativos ----------
  function lerEfeitos() {
    const ef = { defesa: 0, unidade: {}, muralha: 0, cerco: 0, lidos: [] };
    const box = document.querySelector('#show_effects') ||
      [...document.querySelectorAll('.vis, table, div')].find((t) => /^\s*Efeitos ativos/.test(t.querySelector('th, h4')?.textContent || ''));
    if (!box) return ef;

    const nomes = Object.entries(UNITS).map(([k, v]) => [k, v.nome]);
    box.querySelectorAll('tr, li, .effect, div > a').forEach((el) => {
      const txt = [el.getAttribute('title'), el.getAttribute('data-title'), el.textContent]
        .filter(Boolean).join(' ').replace(/\s+/g, ' ').trim().toLowerCase();
      if (!/defesa|muralha/.test(txt)) return;
      const pct = +(txt.match(/\+\s*(\d+(?:[.,]\d+)?)\s*%/) || [])[1]?.replace(',', '.') || 0;
      if (!pct) return;

      if (/efic[áa]cia da muralha/.test(txt)) { ef.muralha += pct; ef.lidos.push(`Muralha +${pct}%`); return; }
      if (/cerco/.test(txt)) { ef.cerco += pct; ef.lidos.push(`Vs cerco +${pct}%`); return; }
      if (/ataque/.test(txt) && !/defesa/.test(txt)) return;

      const un = nomes.find(([, n]) => txt.startsWith(n) || txt.includes(n + ':'));
      if (un && /poder de defesa|for[çc]a de defesa/.test(txt)) {
        ef.unidade[un[0]] = (ef.unidade[un[0]] || 0) + pct;
        ef.lidos.push(`${un[1]} +${pct}%`);
      } else if (!un && /defesa/.test(txt)) {
        ef.defesa += pct; ef.lidos.push(`Defesa +${pct}%`);
      }
    });
    // remove duplicados (title + texto do mesmo elemento)
    ef.lidos = [...new Set(ef.lidos)];
    return ef;
  }

  // ---------- leitura: comandos em chegada ----------
  // Só as linhas mais internas (evita pegar as tabelas de layout da página)
  function linhasComandos() {
    const vistos = new Set();
    return [...document.querySelectorAll('tr')].filter((tr) => {
      if (tr.querySelector('tr')) return false;
      const qe = tr.querySelector('.quickedit[data-id]');
      if (!qe || !tr.querySelector('input[type="checkbox"]')) return false;
      const id = qe.getAttribute('data-id');
      if (vistos.has(id)) return false;
      vistos.add(id);
      return true;
    });
  }

  // Lê "hoje às 18:48:48:946", "amanhã às ..." ou "em 06.10. às ..."
  function chegadaDe(tr) {
    const txt = tr.textContent.replace(/\s+/g, ' ');
    const m = txt.match(/(hoje|amanh[ãa]|em\s+(\d{1,2})\.(\d{1,2})\.?)\s*(?:às|as)\s*(\d{1,2}):(\d{2}):(\d{2})(?::(\d{3}))?/i);
    const d0 = document.querySelector('#serverDate')?.textContent.trim();
    if (m && d0) {
      const [dd, mm, yy] = d0.split('/').map(Number);
      const h = +m[4], mi = +m[5], se = +m[6], ms = +(m[7] || 0);
      let d;
      if (/^em/i.test(m[1])) {
        d = new Date(yy, +m[3] - 1, +m[2], h, mi, se, ms);
        if (d.getTime() < serverWallNow() - 86400000) d.setFullYear(yy + 1);
      } else {
        d = new Date(yy, mm - 1, dd, h, mi, se, ms);
        if (/^amanh/i.test(m[1])) d.setDate(d.getDate() + 1);
      }
      return d.getTime();
    }
    const seg = parseHMS(tr.querySelector('span.timer, [data-endtime]')?.textContent);
    return seg != null ? serverWallNow() + seg * 1000 : 0;
  }

  function lerComandos() {
    return linhasComandos().map((tr) => {
      const qe = tr.querySelector('.quickedit[data-id]');
      const nome = (tr.querySelector('.quickedit-label')?.textContent || '').trim();
      const icones = [...tr.querySelectorAll('img')].map((i) => i.getAttribute('src') || '').join(' ');
      return {
        tr, nome,
        id: qe.getAttribute('data-id'),
        cb: tr.querySelector('input[type="checkbox"]'),
        lbl: tr.querySelector('.quickedit-label'),
        tipo: /support/.test(icones) ? 'apoio' : 'ataque',
        nobre: /snob/.test(icones),
        ignorado: /\(Ignorado\)/i.test(tr.textContent),
        chegada: chegadaDe(tr)
      };
    }).filter((c) => !c.ignorado).sort((a, b) => a.chegada - b.chegada);
  }

  // ---------- leitura: tropas de um apoio (comando compartilhado) ----------
  async function tropasDoApoio(id) {
    if (cacheApoio[id] !== undefined) return cacheApoio[id];
    let tropas = null;
    try {
      const r = await fetch(`/game.php?village=${GD.village.id}&screen=info_command&id=${id}&type=other`, { credentials: 'include' });
      const doc = new DOMParser().parseFromString(await r.text(), 'text/html');

      // 1) células com classe "unit-item-spear", "unit-item-sword"... (pega a primeira tabela)
      const cells = [...doc.querySelectorAll('td[class*="unit-item-"]')];
      if (cells.length) {
        tropas = {};
        cells.forEach((td) => {
          const u = (td.className.match(/unit-item-([a-z]+)/) || [])[1];
          if (u && UNITS[u] && !(u in tropas)) tropas[u] = num(td.textContent);
        });
      } else {
        // 2) cabeçalho com ícones + linha com exatamente o mesmo número de células
        const tab = [...doc.querySelectorAll('table')].find((t) =>
          !t.querySelector('table') && t.querySelectorAll('img[src*="unit_"]').length >= 3);
        if (tab) {
          const linhas = [...tab.querySelectorAll('tr')];
          const iHead = linhas.findIndex((tr) => tr.querySelectorAll('img[src*="unit_"]').length >= 3);
          const units = [...linhas[iHead].querySelectorAll('img[src*="unit_"]')].map((i) => unitDoSrc(i.getAttribute('src')));
          const linhaN = linhas.slice(iHead + 1).find((tr) => tr.querySelectorAll('td').length === units.length);
          if (linhaN) {
            const tds = [...linhaN.querySelectorAll('td')];
            tropas = {};
            units.forEach((u, i) => { if (u && UNITS[u]) tropas[u] = num(tds[i].textContent); });
          }
        }
      }
      // comando não compartilhado (tudo "?" / zero) conta como sem dados
      if (tropas && !Object.values(tropas).some((v) => v > 0)) tropas = null;
    } catch (e) { tropas = null; }
    cacheApoio[id] = tropas;
    salvarCache();
    await sleep(220);
    return tropas;
  }

  async function somarApoios(lista, rotulo) {
    const soma = {}; let semDados = 0;
    for (let i = 0; i < lista.length; i++) {
      status(`Lendo apoios ${rotulo}: ${i + 1}/${lista.length}…`);
      const t = await tropasDoApoio(lista[i].id);
      if (!t) { semDados++; continue; }
      for (const u in t) soma[u] = (soma[u] || 0) + t[u];
    }
    return { soma, semDados };
  }

  function textoTropas(soma) {
    const ordem = ['spear', 'sword', 'heavy', 'archer', 'knight', 'axe', 'light', 'marcher', 'spy', 'ram', 'catapult', 'snob'];
    const partes = ordem.filter((u) => soma[u] > 0 && u !== 'spy').map((u) => `${fmtN(soma[u])} ${UNITS[u].ab}`);
    return partes.length ? partes.join(' | ') : '0';
  }

  // ---------- simulação ----------
  function simular(tropasIn, muralhaIn, ef) {
    const A = [0, 0, 0];
    for (const u in cfg.full) {
      const s = UNITS[u]; if (!s) continue;
      let a = (cfg.full[u] || 0) * s.a;
      if (SIEGE.includes(u)) a /= (1 + ef.cerco / 100);
      A[s.t] += a;
    }
    const At = A[0] + A[1] + A[2];
    if (!At) return 0;

    const def = { ...tropasIn };
    let muralha = muralhaIn;
    const rams = cfg.full.ram || 0;
    const gDef = 1 + ef.defesa / 100;
    const mEf = 1 + ef.muralha / 100;

    for (let k = 0; k < 30; k++) {
      const red = Math.floor(rams / (2 * Math.pow(1.09, muralha)));
      const mB = Math.max(Math.ceil(muralha / 2), muralha - red);

      let D = 0;
      for (const u in def) {
        const s = UNITS[u]; if (!s) continue;
        const mult = 1 + (ef.unidade[u] || 0) / 100;
        D += def[u] * mult * (s.d[0] * A[0] + s.d[1] * A[1] + s.d[2] * A[2]) / At;
      }
      const base = (20 + 50 * mB) * mEf;
      const bonusMur = 1 + (Math.pow(1.037, mB) - 1) * mEf;
      D = (D + base) * bonusMur * gDef;

      if (At >= D) return k;
      const perda = Math.pow(At / D, 1.5);
      for (const u in def) def[u] = Math.floor(def[u] * (1 - perda));
      muralha = Math.max(0, muralha - Math.floor((rams * perda) / (4 * Math.pow(1.09, muralha))));
    }
    return 30;
  }

  // ---------- renomear ----------
  function renomear(c, texto) {
    if (!cfg.renomear || c.nome === texto) return Promise.resolve(true);
    return new Promise((resolve) => {
      let feito = false;
      const fim = (ok) => {
        if (feito) return; feito = true;
        if (ok) { c.nome = texto; if (c.lbl) c.lbl.textContent = texto; }
        resolve(ok);
      };
      try {
        window.TribalWars.post('info_command', { ajaxaction: 'edit_other_comment', id: c.id }, { text: texto },
          () => fim(true), () => fim(false));
      } catch (e) { fim(false); }
      setTimeout(() => fim(false), 8000);
    });
  }

  // ---------- execução ----------
  let rodando = false;
  async function executar() {
    if (rodando) return;
    rodando = true;
    try {
      const comandos = lerComandos();
      const ataques = comandos.filter((c) => c.tipo === 'ataque');
      const apoios = comandos.filter((c) => c.tipo === 'apoio');
      const unidades = lerUnidades();
      const efeitos = lerEfeitos();
      const muralha = parseInt(GD.village?.buildings?.wall, 10) || 0;

      const primeiroAtq = ataques[0]?.chegada || Infinity;
      const apoiosAntes = apoios.filter((c) => c.chegada < primeiroAtq);
      const apoiosDepois = apoios.filter((c) => c.chegada >= primeiroAtq);

      const antes = await somarApoios(apoiosAntes, 'antes');
      const depois = await somarApoios(apoiosDepois, 'depois');

      const comApoio = { ...unidades };
      for (const u in antes.soma) comApoio[u] = (comApoio[u] || 0) + antes.soma[u];

      const fullsAgora = simular(unidades, muralha, efeitos);
      const fullsChegada = simular(comApoio, muralha, efeitos);

      // representantes
      const repAtq = ataques[0];                       // renomeia o PRIMEIRO ataque
      const ultAtq = ataques[ataques.length - 1];
      const repAntes = apoiosAntes[apoiosAntes.length - 1];
      const repDepois = apoiosDepois[apoiosDepois.length - 1];
      const reps = new Set([repAtq, repAntes, repDepois].filter(Boolean).map((c) => c.id));

      status('Renomeando…');
      if (repAtq) {
        const n = ataques.length, nob = ataques.filter((c) => c.nobre).length;
        await renomear(repAtq, `${P_ATQ} ${n} ataque${n > 1 ? 's' : ''}${nob ? ` | ${nob} nobre${nob > 1 ? 's' : ''}` : ''} | aguenta ${fullsChegada >= 30 ? '30+' : fullsChegada} | 1º ${hms(repAtq.chegada)} | últ ${hms(ultAtq.chegada)}`);
        await sleep(250);
      }
      const sd = (x) => (x.semDados ? ` (+${x.semDados} s/dados)` : '');
      if (repAntes) {
        await renomear(repAntes, `${P_APOIO} ${ataques.length ? 'antes' : 'apoio'}: +${textoTropas(antes.soma)}${sd(antes)}`);
        await sleep(250);
      }
      if (repDepois) {
        await renomear(repDepois, `${P_APOIO} depois: +${textoTropas(depois.soma)}${sd(depois)}`);
      }

      // seleção para ignorar
      let marcados = 0;
      comandos.forEach((c) => {
        const marcar = !reps.has(c.id);
        if (c.cb.checked !== marcar) c.cb.click();          // dispara os handlers do jogo
        if (c.cb.checked !== marcar) c.cb.checked = marcar;
        c.tr.style.background = marcar ? '' : '#d8f0c8';
        if (marcar) marcados++;
      });

      mostrarResumo({
        ataques, apoiosAntes, apoiosDepois, antes, depois, unidades, efeitos, muralha,
        fullsAgora, fullsChegada, marcados
      });
      status(`Pronto. ${marcados} comandos marcados — clique em "Ignorar".`);
      const btn = [...document.querySelectorAll('input[type="submit"], input[type="button"], button, a.btn')]
        .find((b) => /^\s*Ignorar\s*$/i.test(b.value || b.textContent));
      if (btn) { btn.style.outline = '3px solid #e67e22'; btn.scrollIntoView({ block: 'center', behavior: 'smooth' }); }
    } catch (e) {
      status('Erro: ' + e.message, true);
    } finally {
      rodando = false;
    }
  }

  // ---------- interface ----------
  function corFulls(f, n) { return f < n ? '#c0392b' : f <= n + 1 ? '#e67e22' : '#27ae60'; }

  function status(msg, erro) {
    const el = document.querySelector(`#${BOX_ID} .jj-st`);
    if (el) { el.textContent = msg; el.style.color = erro ? '#c0392b' : '#5a4a2a'; }
  }

  function mostrarResumo(r) {
    const el = document.querySelector(`#${BOX_ID} .jj-res`);
    if (!el) return;
    const n = r.ataques.length;
    const badge = (f) => `<span style="padding:1px 6px;border-radius:3px;color:#fff;font-weight:bold;background:${corFulls(f, n)}">${f >= 30 ? '30+' : f}</span>`;
    el.innerHTML = `
      <table class="vis" style="width:100%">
        <tr><td>Ataques</td><td><b>${n}</b>${n ? ` (1º ${hms(r.ataques[0].chegada)} · últ ${hms(r.ataques[n - 1].chegada)})` : ''}</td></tr>
        <tr><td>Apoio antes do 1º ataque</td><td>${r.apoiosAntes.length} cmd — +${textoTropas(r.antes.soma)}${r.antes.semDados ? ` <i>(+${r.antes.semDados} sem dados)</i>` : ''}</td></tr>
        <tr><td>Apoio depois</td><td>${r.apoiosDepois.length} cmd — +${textoTropas(r.depois.soma)}${r.depois.semDados ? ` <i>(+${r.depois.semDados} sem dados)</i>` : ''}</td></tr>
        <tr><td>Muralha</td><td>${r.muralha}</td></tr>
        <tr><td>Efeitos lidos</td><td>${r.efeitos.lidos.join(' · ') || '<i>nenhum</i>'}</td></tr>
        <tr><td>Aguenta agora</td><td>${badge(r.fullsAgora)} fulls</td></tr>
        <tr><td>Aguenta com apoio a caminho</td><td>${badge(r.fullsChegada)} fulls</td></tr>
      </table>`;
  }

  function montarCaixa() {
    document.getElementById(BOX_ID)?.remove();
    const alvo = linhasComandos()[0];
    const ancora = alvo ? alvo.closest('table') : (document.querySelector('#content_value')?.firstElementChild || null);

    const box = document.createElement('div');
    box.id = BOX_ID;
    box.style.cssText = 'background:#f4e4bc;border:2px solid #7d510f;border-radius:5px;padding:6px;margin:6px 0;font:12px Verdana,Arial;';
    const inp = (u, lbl) => `<label style="margin-right:6px">${lbl} <input data-u="${u}" type="number" min="0" value="${cfg.full[u] || 0}" style="width:52px"></label>`;
    box.innerHTML = `
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px">
        <b>⚔ JJ Ataques Recebidos v1.2 — por aldeia</b>
        <span><button class="btn jj-run">Rodar de novo</button> <button class="btn jj-x">✕</button></span>
      </div>
      <div style="margin-bottom:4px"><b>Full:</b> ${inp('axe', 'Bárbaro')}${inp('light', 'CL')}${inp('marcher', 'AC')}${inp('ram', 'Aríete')}
        <label><input type="checkbox" class="jj-ren" ${cfg.renomear ? 'checked' : ''}> Renomear</label></div>
      <div class="jj-st" style="margin-bottom:4px"></div>
      <div class="jj-res"></div>
      <div style="margin-top:4px;color:#6b5a3a;font-size:11px">Verde na lista = resumos que ficam. O resto já está marcado para ignorar.
        Estimativa sem sorte, moral e bônus noturno.</div>`;
    if (ancora && ancora.parentNode) ancora.parentNode.insertBefore(box, ancora);
    else document.body.prepend(box);

    box.querySelector('.jj-run').onclick = () => { cacheApoio = {}; salvarCache(); executar(); };
    box.querySelector('.jj-x').onclick = () => box.remove();
    box.querySelector('.jj-ren').onchange = (e) => { cfg.renomear = e.target.checked; salvarCfg(); };
    box.querySelectorAll('input[data-u]').forEach((i) => i.onchange = () => { cfg.full[i.dataset.u] = num(i.value); salvarCfg(); });
  }

  montarCaixa();
  executar();
}
