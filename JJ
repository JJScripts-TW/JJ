    var canvas = document.getElementById("jjwm-canvas");
    var ctx = canvas.getContext("2d");
    var statusEl = document.getElementById("jjwm-status");

    var dpr = window.devicePixelRatio || 1;
    function resizeCanvas() {
        var rect = canvas.getBoundingClientRect();
        canvas.width = rect.width * dpr;
        canvas.height = rect.height * dpr;
    }
    resizeCanvas();

    var state = {
        minX: 0, maxX: 999, minY: 0, maxY: 999,
        scale: 1, offsetX: 0, offsetY: 0,
        mine: [], tribe: [], ally: [], pna: [], enemy: [], other: [],
        lines: { atkOut: [], atkIn: [], supOut: [], supBack: [], supIn: [] }
    };

    function fitToView() {
        var w = canvas.width, h = canvas.height;
        var worldW = Math.max(1, state.maxX - state.minX);
        var worldH = Math.max(1, state.maxY - state.minY);
        var scaleX = w / worldW;
        var scaleY = h / worldH;
        state.scale = Math.min(scaleX, scaleY) * 0.95;
        state.offsetX = (w - worldW * state.scale) / 2;
        state.offsetY = (h - worldH * state.scale) / 2;
    }

    function worldToScreen(x, y) {
        return [
            (x - state.minX) * state.scale + state.offsetX,
            (y - state.minY) * state.scale + state.offsetY
        ];
    }

    var pendingDraw = false;
    function draw() {
        if (pendingDraw) return;
        pendingDraw = true;
        requestAnimationFrame(function () {
            pendingDraw = false;
            ctx.setTransform(1, 0, 0, 1, 0, 0);
            ctx.fillStyle = "#08090c";
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            var dotOther = Math.max(1, state.scale * 0.8);
            ctx.fillStyle = COLOR_OTHER;
            state.other.forEach(function (v) {
                var p = worldToScreen(v.x, v.y);
                if (p[0] < -5 || p[0] > canvas.width + 5 || p[1] < -5 || p[1] > canvas.height + 5) return;
                ctx.fillRect(p[0], p[1], dotOther, dotOther);
            });

            function drawGroup(list, color) {
                ctx.fillStyle = color;
                list.forEach(function (v) {
                    var p = worldToScreen(v.x, v.y);
                    if (p[0] < -5 || p[0] > canvas.width + 5 || p[1] < -5 || p[1] > canvas.height + 5) return;
                    ctx.fillRect(p[0], p[1], dotOther, dotOther);
                });
            }
            drawGroup(state.pna, COLOR_PNA);
            drawGroup(state.ally, COLOR_ALLY);
            drawGroup(state.enemy, COLOR_ENEMY);
            drawGroup(state.tribe, COLOR_TRIBE);
            drawGroup(state.mine, COLOR_ME);

            var lineWidth = Math.max(0.5, state.scale * 0.35);

            function drawLines(list, color, dashed, checked) {
                if (!checked || !list.length) return;
                ctx.lineCap = "round";
                ctx.lineJoin = "round";
                ctx.shadowBlur = 0;
                ctx.strokeStyle = color;
                ctx.globalAlpha = 0.8;
                ctx.lineWidth = lineWidth;
                ctx.setLineDash(dashed ? [lineWidth * 3, lineWidth * 2.2] : []);

                list.forEach(function (l) {
                    var p1 = worldToScreen(l.from.x, l.from.y);
                    var p2 = worldToScreen(l.to.x, l.to.y);
                    ctx.beginPath();
                    ctx.moveTo(p1[0], p1[1]);
                    ctx.lineTo(p2[0], p2[1]);
                    ctx.stroke();
                });

                ctx.setLineDash([]);
                ctx.globalAlpha = 1;
            }

            function drawMovingDots(list, color) {
                var speedInput = document.getElementById("jjwm-speed");
                var manualSpeed = speedInput ? parseFloat(speedInput.value) || 18 : 18;
                var now = Date.now();
                var dotR = lineWidth * 1.15;

                ctx.fillStyle = color;
                ctx.shadowColor = color;
                ctx.shadowBlur = dotR * 0.8;

                list.forEach(function (l) {
                    if (!l.arrival) return;
                    var distFields = Math.sqrt(
                        (l.to.x - l.from.x) * (l.to.x - l.from.x) +
                        (l.to.y - l.from.y) * (l.to.y - l.from.y)
                    );
                    var speed = l.speedOverride || manualSpeed;
                    var totalMs = distFields * speed * 60000;
                    if (totalMs <= 0) return;
                    var startMs = l.arrival - totalMs;
                    var progress = (now - startMs) / totalMs;
                    if (progress < 0 || progress > 1) return;

                    var p1 = worldToScreen(l.from.x, l.from.y);
                    var p2 = worldToScreen(l.to.x, l.to.y);
                    var px = p1[0] + (p2[0] - p1[0]) * progress;
                    var py = p1[1] + (p2[1] - p1[1]) * progress;

                    ctx.beginPath();
                    ctx.arc(px, py, dotR, 0, Math.PI * 2);
                    ctx.fill();
                });

                ctx.shadowBlur = 0;
            }

            var cbAtkOut = document.getElementById("jjwm-cb-atk-out");
            var cbAtkIn = document.getElementById("jjwm-cb-atk-in");
            var cbSupOut = document.getElementById("jjwm-cb-sup-out");
            var cbSupBack = document.getElementById("jjwm-cb-sup-back");

            var cbSupIn = document.getElementById("jjwm-cb-sup-in");

            drawLines(state.lines.atkOut, "#3ddc5a", false, cbAtkOut && cbAtkOut.checked);
            drawLines(state.lines.atkIn, "#e04b4b", false, cbAtkIn && cbAtkIn.checked);
            drawLines(state.lines.supOut, "#3ddc5a", false, cbSupOut && cbSupOut.checked);
            drawLines(state.lines.supBack, "#3ddc5a", true, cbSupBack && cbSupBack.checked);
            drawLines(state.lines.supIn, "#5bc0f8", false, cbSupIn && cbSupIn.checked);

            if (cbAtkOut && cbAtkOut.checked) drawMovingDots(state.lines.atkOut, "#3ddc5a");
            if (cbAtkIn && cbAtkIn.checked) drawMovingDots(state.lines.atkIn, "#e04b4b");
            if (cbSupIn && cbSupIn.checked) drawMovingDots(state.lines.supIn, "#5bc0f8");
        });
    }

    setInterval(function () { draw(); }, 250);

    // ---- carregar dados ----
    var myId = null;
    try { myId = window.game_data && game_data.player && String(game_data.player.id); } catch (e) {}

    function fetchText(url) { return fetch(url).then(function (r) { return r.text(); }); }

    var BASE_SPEEDS = { spear: 18, sword: 22, axe: 18, archer: 18, spy: 9, light: 10, marcher: 10, heavy: 11, ram: 30, catapult: 30, knight: 10, snob: 35 };
    var worldConfig = { speed: 1, unitSpeed: 1 };

    function fetchWorldConfig() {
        return fetch("/interface.php?func=get_config").then(function (r) { return r.text(); }).then(function (xml) {
            var doc = new DOMParser().parseFromString(xml, "text/xml");
            var speedEl = doc.querySelector("speed");
            var unitSpeedEl = doc.querySelector("unit_speed");
            worldConfig.speed = speedEl ? parseFloat(speedEl.textContent) || 1 : 1;
            worldConfig.unitSpeed = unitSpeedEl ? parseFloat(unitSpeedEl.textContent) || 1 : 1;
        }).catch(function () {});
    }

    function mapUnitColumns(table) {
        var map = {};
        if (!table) return map;
        var headerRow = table.querySelector("thead tr") || table.querySelector("tr:first-child");
        if (!headerRow) return map;
        var cells = headerRow.querySelectorAll("th, td");
        var unitKeys = ["spear", "sword", "axe", "archer", "spy", "light", "marcher", "heavy", "ram", "catapult", "knight", "snob", "militia"];
        cells.forEach(function (cell, i) {
            var img = cell.querySelector("img");
            var unitEl = cell.querySelector("[data-unit]");
            var src = img ? (img.getAttribute("src") || "") : "";
            var dataUnit = unitEl ? unitEl.getAttribute("data-unit") : (cell.getAttribute("data-unit") || "");
            unitKeys.forEach(function (key) {
                if (dataUnit === key || new RegExp("unit_" + key, "i").test(src)) map[i] = key;
            });
        });
        return map;
    }

    function slowestSpeedForRow(cells, unitColMap) {
        var slowestBase = null;
        Object.keys(unitColMap).forEach(function (idxStr) {
            var idx = parseInt(idxStr, 10);
            if (!cells[idx]) return;
            var count = parseInt((cells[idx].textContent || "0").replace(/\D/g, ""), 10) || 0;
            if (count <= 0) return;
            var base = BASE_SPEEDS[unitColMap[idx]];
            if (base && (slowestBase === null || base > slowestBase)) slowestBase = base;
        });
        if (!slowestBase) return null;
        return slowestBase / (worldConfig.speed * worldConfig.unitSpeed);
    }

    function fetchDiplomacy() {
        var villageId = "0";
        try { if (window.game_data && game_data.village) villageId = game_data.village.id; } catch (e) {}
        var url = "/game.php?village=" + villageId + "&screen=ally&mode=contracts";

        return fetch(url, { credentials: "same-origin" }).then(function (res) { return res.text(); }).then(function (html) {
            var doc = new DOMParser().parseFromString(html, "text/html");
            var allyIds = [], pnaIds = [], enemyIds = [];
            var currentSection = null;

            var allNodes = doc.body.querySelectorAll("*");
            allNodes.forEach(function (el) {
                var ownText = "";
                for (var c = 0; c < el.childNodes.length; c++) {
                    if (el.childNodes[c].nodeType === 3) ownText += el.childNodes[c].textContent;
                }
                ownText = ownText.trim();

                if (ownText && /^aliad/i.test(ownText)) { currentSection = "ally"; return; }
                if (ownText && /pactos? de n[aã]o.?agress/i.test(ownText)) { currentSection = "pna"; return; }
                if (ownText && /^inimig/i.test(ownText)) { currentSection = "enemy"; return; }

                if (el.tagName === "A" && el.textContent.trim() === "Terminar") {
                    var href = el.getAttribute("href") || "";
                    var m = href.match(/[?&]id=(\d+)/);
                    if (!m || !currentSection) return;
                    var id = m[1];
                    if (currentSection === "ally") allyIds.push(id);
                    else if (currentSection === "pna") pnaIds.push(id);
                    else if (currentSection === "enemy") enemyIds.push(id);
                }
            });

            return { allyIds: allyIds, pnaIds: pnaIds, enemyIds: enemyIds };
        });
    }

    if (!myId) {
        statusEl.textContent = "⚠️ Não consegui identificar seu jogador (game_data.player.id ausente).";
    } else {
        statusEl.textContent = "🔎 Lendo diplomacia da tribo...";

        fetchDiplomacy().then(function (diplo) {
            fetchText("/map/player.txt").then(function (playerText) {
                var lines = playerText.split("\n");
                var myAllyId = null;
                var allyOf = {};
                for (var i = 0; i < lines.length; i++) {
                    var line = lines[i].trim();
                    if (!line) continue;
                    var cols = line.split(",");
                    if (cols.length < 3) continue;
                    allyOf[cols[0]] = cols[2];
                    if (cols[0] === myId) myAllyId = cols[2];
                }

                var allySet = {}; diplo.allyIds.forEach(function (id) { allySet[id] = true; });
                var pnaSet = {}; diplo.pnaIds.forEach(function (id) { pnaSet[id] = true; });
                var enemySet = {}; diplo.enemyIds.forEach(function (id) { enemySet[id] = true; });

                statusEl.textContent = "🔎 Baixando aldeias do mundo...";

                fetchText("/map/village.txt").then(function (villageText) {
                    var vLines = villageText.split("\n");
                    var mine = [], tribe = [], ally = [], pna = [], enemy = [], other = [];
                    var minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;

                    for (var j = 0; j < vLines.length; j++) {
                        var vline = vLines[j].trim();
                        if (!vline) continue;
                        var vcols = vline.split(",");
                        if (vcols.length < 5) continue;
                        var x = parseInt(vcols[2], 10);
                        var y = parseInt(vcols[3], 10);
                        if (isNaN(x) || isNaN(y)) continue;
                        var pid = vcols[4];
                        var pAllyId = pid ? allyOf[pid] : null;

                        if (x < minX) minX = x;
                        if (x > maxX) maxX = x;
                        if (y < minY) minY = y;
                        if (y > maxY) maxY = y;

                        if (pid === myId) {
                            mine.push({ x: x, y: y });
                        } else if (pAllyId && myAllyId && pAllyId === myAllyId) {
                            tribe.push({ x: x, y: y });
                        } else if (pAllyId && enemySet[pAllyId]) {
                            enemy.push({ x: x, y: y });
                        } else if (pAllyId && allySet[pAllyId]) {
                            ally.push({ x: x, y: y });
                        } else if (pAllyId && pnaSet[pAllyId]) {
                            pna.push({ x: x, y: y });
                        } else {
                            other.push({ x: x, y: y });
                        }
                    }

                    state.minX = minX; state.maxX = maxX; state.minY = minY; state.maxY = maxY;
                    state.mine = mine; state.tribe = tribe; state.ally = ally; state.pna = pna; state.enemy = enemy; state.other = other;

                    fitToView();
                    draw();

                    statusEl.textContent = "✅ " + (mine.length + tribe.length + ally.length + pna.length + enemy.length + other.length) + " aldeias — " +
                        mine.length + " minhas, " + tribe.length + " da tribo, " + ally.length + " aliadas, " + pna.length + " PNA, " + enemy.length + " inimigas.";
                }).catch(function (e) { statusEl.textContent = "❌ Erro ao baixar village.txt: " + e.message; });
            }).catch(function (e) { statusEl.textContent = "❌ Erro ao baixar player.txt: " + e.message; });
        }).catch(function (e) { statusEl.textContent = "❌ Erro ao ler diplomacia: " + e.message; });
    }

    function extractCoord(text) {
        var m = String(text || "").match(/\((\d{1,3})\|(\d{1,3})\)/);
        if (!m) return null;
        return { x: parseInt(m[1], 10), y: parseInt(m[2], 10) };
    }

    function parseArrival(text) {
        var t = String(text || "").trim();
        var m = t.match(/(hoje|amanh[aã])\s+[aà]s\s+(\d{1,2}):(\d{2}):(\d{2})(?::(\d{1,3}))?/i);
        if (!m) return null;
        var now = new Date();
        var d = new Date(now.getFullYear(), now.getMonth(), now.getDate(),
            parseInt(m[2], 10), parseInt(m[3], 10), parseInt(m[4], 10), m[5] ? parseInt(m[5], 10) : 0);
        if (/amanh/i.test(m[1])) d.setDate(d.getDate() + 1);
        return d.getTime();
    }

    function findBiggestTable(doc) {
        var tables = doc.querySelectorAll("table.vis");
        var best = null, bestCount = 0;
        tables.forEach(function (t) {
            var rows = t.querySelectorAll("tbody tr");
            if (rows.length > bestCount) { bestCount = rows.length; best = t; }
        });
        return best;
    }

    function loadCommands() {
        var villageId = "0";
        try { if (window.game_data && game_data.village) villageId = game_data.village.id; } catch (e) {}

        var combinedUrl = "/game.php?village=" + villageId + "&screen=overview_villages&mode=commands";
        var incomingsUrl = "/game.php?village=" + villageId + "&screen=overview_villages&mode=incomings&type=unignored&subtype=all";

        statusEl.textContent = "🔎 Carregando comandos enviados/retornando...";

        fetchWorldConfig().then(function () {
        fetch(combinedUrl, { credentials: "same-origin" }).then(function (r) { return r.text(); }).then(function (html) {
            var doc = new DOMParser().parseFromString(html, "text/html");
            var table = findBiggestTable(doc);
            var atkOut = [], supOut = [], supBack = [];
            var unitColMap = mapUnitColumns(table);

            if (table) {
                var rows = table.querySelectorAll("tbody tr");
                rows.forEach(function (row) {
                    var cells = row.querySelectorAll("td");
                    if (cells.length < 2) return;
                    var desc = (cells[0].textContent || "").trim();
                    var target = extractCoord(desc);
                    var origin = extractCoord(cells[1].textContent);
                    if (!target || !origin) return;

                    var arrival = parseArrival(cells[2] ? cells[2].textContent : "");
                    var autoSpeed = slowestSpeedForRow(cells, unitColMap);

                    if (/^Ataque a/i.test(desc)) {
                        atkOut.push({ from: origin, to: target, arrival: arrival, speedOverride: autoSpeed });
                    } else if (/^Apoio a/i.test(desc)) {
                        supOut.push({ from: origin, to: target, arrival: arrival, speedOverride: autoSpeed });
                    } else if (/^Retorno de/i.test(desc)) {
                        supBack.push({ from: target, to: origin, arrival: arrival, speedOverride: autoSpeed });
                    }
                });
            }

            state.lines.atkOut = atkOut;
            state.lines.supOut = supOut;
            state.lines.supBack = supBack;

            statusEl.textContent = "🔎 Carregando ataques recebidos...";

            fetch(incomingsUrl, { credentials: "same-origin" }).then(function (r2) { return r2.text(); }).then(function (html2) {
                var doc2 = new DOMParser().parseFromString(html2, "text/html");
                var table2 = findBiggestTable(doc2);
                var atkIn = [], supIn = [];

                if (table2) {
                    var rows2 = table2.querySelectorAll("tbody tr");
                    rows2.forEach(function (row) {
                        var cells2 = row.querySelectorAll("td");
                        if (cells2.length < 3) return;
                        var tipo = (cells2[0].textContent || "").trim();
                        var destino = extractCoord(cells2[1].textContent);
                        var origem = extractCoord(cells2[2].textContent);
                        if (!destino || !origem) return;
                        var arrivalIn = parseArrival(cells2[5] ? cells2[5].textContent : "");

                        if (/ataque/i.test(tipo)) {
                            atkIn.push({ from: origem, to: destino, arrival: arrivalIn });
                        } else if (/suporte|apoio/i.test(tipo)) {
                            supIn.push({ from: origem, to: destino, arrival: arrivalIn });
                        }
                    });
                }

                state.lines.atkIn = atkIn;
                state.lines.supIn = supIn;
                draw();
                statusEl.textContent = "✅ Linhas: " + atkOut.length + " atacando, " + atkIn.length + " recebendo, " +
                    supOut.length + " apoio indo, " + supBack.length + " apoio/retorno voltando, " + supIn.length + " apoio chegando.";
            }).catch(function (e) { statusEl.textContent = "❌ Erro ao carregar recebidos: " + e.message; });
        }).catch(function (e) { statusEl.textContent = "❌ Erro ao carregar comandos: " + e.message; });
        });
    }

    document.getElementById("jjwm-load-commands").onclick = loadCommands;
    ["jjwm-cb-atk-out", "jjwm-cb-atk-in", "jjwm-cb-sup-out", "jjwm-cb-sup-back", "jjwm-cb-sup-in"].forEach(function (id) {
        document.getElementById(id).addEventListener("change", draw);
    });

    // ---- zoom / pan ----
    document.getElementById("jjwm-zoom-in").onclick = function () { zoomAt(canvas.width / 2, canvas.height / 2, 1.4); };
    document.getElementById("jjwm-zoom-out").onclick = function () { zoomAt(canvas.width / 2, canvas.height / 2, 1 / 1.4); };
    document.getElementById("jjwm-reset").onclick = function () { fitToView(); draw(); };

    function zoomAt(sx, sy, factor) {
        var wx = (sx - state.offsetX) / state.scale;
        var wy = (sy - state.offsetY) / state.scale;
        state.scale *= factor;
        state.offsetX = sx - wx * state.scale;
        state.offsetY = sy - wy * state.scale;
        draw();
    }

    var dragging = false, lastX = 0, lastY = 0;
    var pinchDist = null;

    function getTouchDist(touches) {
        var dx = touches[0].clientX - touches[1].clientX;
        var dy = touches[0].clientY - touches[1].clientY;
        return Math.sqrt(dx * dx + dy * dy);
    }

    canvas.addEventListener("touchstart", function (e) {
        if (e.touches.length === 1) {
            dragging = true;
            lastX = e.touches[0].clientX;
            lastY = e.touches[0].clientY;
        } else if (e.touches.length === 2) {
            dragging = false;
            pinchDist = getTouchDist(e.touches);
        }
